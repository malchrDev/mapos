# Modelo do docker/producao/.env do Map-OS SaaS (copie para .env e preencha).
# O .env fica fora do git. Gere cada chave com o comando indicado; nunca
# reaproveite as do ambiente de teste.

# --- Docker ---
# Senha do root do MySQL deste projeto:  openssl rand -base64 24
MYSQL_ROOT_PASSWORD=
# Pasta do host com uploads, backups e as rotas do Traefik.
MAPOS_DADOS=/opt/mapos-dados

# --- Aplicação ---
# Nome que aparece no título das páginas e nos e-mails.
APP_NAME="Map-OS"
APP_SUBNAME="Sistema de Controle de Ordens de Serviço"
APP_TIMEZONE=America/Sao_Paulo
# Só a linha de comando usa (esquema dos links); na web vale o endereço da empresa.
APP_BASEURL="https://painel.gestordauel.com.br/"
APP_CHARSET=UTF-8
APP_ENVIRONMENT=production
#   openssl rand -base64 32      (não troque depois: os segredos cifrados deixam de abrir)
APP_ENCRYPTION_KEY=
APP_SESS_DRIVER=database
APP_SESS_COOKIE_NAME=MAPOS_SESSION
APP_SESS_EXPIRATION=7200
APP_SESS_SAVE_PATH=ci_sessions
APP_SESS_MATCH_IP=false
APP_SESS_TIME_TO_UPDATE=300
APP_SESS_REGENERATE_DESTROY=true
APP_COOKIE_PREFIX=
# Sempre vazio no SaaS (o hook força vazio de qualquer forma).
APP_COOKIE_DOMAIN=
APP_COOKIE_PATH=/
APP_COOKIE_SECURE=true
APP_COOKIE_HTTPONLY=true
APP_COOKIE_SAMESITE=Lax
APP_CSRF_PROTECTION=true
APP_CSRF_TOKEN_NAME="MAPOS_CSRF_TOKEN"
APP_CSRF_COOKIE_NAME="MAPOS_CSRF_COOKIE"
APP_CSRF_EXPIRE=7200
APP_CSRF_REGENERATE=true
APP_COMPRESS_OUTPUT=false
APP_PROXY_IPS=
APP_SECURITY_HEADERS=true
APP_HSTS_MAX_AGE=31536000
# false: o HSTS de uma empresa não deve valer para os outros sistemas do domínio.
APP_HSTS_INCLUDE_SUBDOMAINS=false
APP_CSP=enforce
APP_CSP_REPORT=true
WHOOPS_ERROR_PAGE_ENABLED=false
UPDATER_PRERELEASES=false

# --- Banco (container mysql deste projeto) ---
DB_DSN=
DB_HOSTNAME=mysql
DB_PORT=3306
DB_USERNAME=mapos
#   openssl rand -base64 24
DB_PASSWORD=
DB_DATABASE=mapos_base
DB_DRIVER=mysqli
DB_PREFIX=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_MASTER_DATABASE=mapos_master

# --- SaaS ---
SAAS_DOMINIO_BASE=gestordauel.com.br
SAAS_PAINEL_HOST=painel.gestordauel.com.br
# Subdomínios de outros sistemas no mesmo domínio (o ZAPScout usa app e api).
SAAS_SUBDOMINIOS_RESERVADOS=app,api
SAAS_EMAIL_REMETENTE=nao-responda@gestordauel.com.br
SAAS_BACKUP_PATH=/backups
SAAS_BACKUP_RETENCAO_DIAS=14
SAAS_TRAEFIK_ARQUIVO=/traefik/mapos.yml
SAAS_TRAEFIK_SERVICO_URL=http://mapos-nginx:80
SAAS_TRAEFIK_CERTRESOLVER=le
SAAS_TRAEFIK_ENTRYPOINT=websecure
STORAGE_PATH=/storage
UPLOAD_MAX_KB=
UPLOAD_MAX_PIXELS=

# --- E-mail (SMTP da plataforma; o domínio do remetente precisa de SPF/DKIM) ---
EMAIL_PROTOCOL=smtp
EMAIL_SMTP_HOST=
EMAIL_SMTP_CRYPTO=tls
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
EMAIL_VALIDATE=true
EMAIL_MAILTYPE=html
EMAIL_CHARSET=utf-8
EMAIL_BCC_BATCH_MODE=false
EMAIL_WORDWRAP=false
EMAIL_PRIORITY=3

# --- API (cada empresa liga a sua em Configurações; aqui é o padrão) ---
API_ENABLED=false
#   openssl rand -base64 48
API_JWT_KEY=
API_TOKEN_EXPIRE_TIME=3600
API_REFRESH_TOKEN_EXPIRE_TIME=2592000
API_CORS_ORIGINS=
API_RATE_LIMIT=300
IMPRIMIR_ANEXOS=false
