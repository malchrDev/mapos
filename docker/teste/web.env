# Ambiente LOCAL de testes (docker/teste). Chaves e senhas fixas e públicas:
# nunca reutilizar em produção.
APP_NAME="Map-OS"
APP_SUBNAME="Sistema de Controle de Ordens de Serviço"
APP_TIMEZONE=America/Sao_Paulo
# Fallback; com tenant resolvido o hook usa o hostname da requisição.
APP_BASEURL="http://localhost:8090/"
APP_CHARSET=UTF-8
APP_ENCRYPTION_KEY="chave-local-de-teste-nao-usar-em-producao-000000"
APP_ENVIRONMENT=development
APP_SESS_DRIVER=database
APP_SESS_COOKIE_NAME=MAPOS_SESSION
APP_SESS_EXPIRATION=7200
APP_SESS_SAVE_PATH=ci_sessions
APP_SESS_MATCH_IP=false
APP_SESS_TIME_TO_UPDATE=300
APP_SESS_REGENERATE_DESTROY=true
APP_COOKIE_PREFIX=
# Vazio: cookie só do hostname pedido — a sessão de um tenant não vale no outro.
APP_COOKIE_DOMAIN=
APP_COOKIE_PATH=/
APP_COOKIE_SECURE=auto
APP_COOKIE_HTTPONLY=true
APP_COOKIE_SAMESITE=Lax
APP_CSRF_PROTECTION=true
APP_CSRF_TOKEN_NAME="MAPOS_CSRF_TOKEN"
APP_CSRF_COOKIE_NAME="MAPOS_CSRF_COOKIE"
APP_CSRF_EXPIRE=7200
APP_CSRF_REGENERATE=true
APP_COMPRESS_OUTPUT=false
APP_PROXY_IPS=
APP_SECURITY_HEADERS=true
APP_HSTS_MAX_AGE=31536000
APP_HSTS_INCLUDE_SUBDOMAINS=false
APP_CSP=enforce
APP_CSP_REPORT=true

DB_DSN=
DB_HOSTNAME=mysql
DB_PORT=3306
DB_USERNAME=mapos
DB_PASSWORD=mapos_teste
DB_DATABASE=mapos_padrao
DB_DRIVER=mysqli
DB_PREFIX=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_MASTER_DATABASE=mapos_master

# Multi-tenancy: subdomínios *.localhost resolvem para 127.0.0.1 no navegador.
SAAS_DOMINIO_BASE=localhost
SAAS_PAINEL_HOST=painel.localhost
SAAS_EMAIL_REMETENTE=nao-responda@plataforma.localhost

EMAIL_PROTOCOL=smtp
EMAIL_SMTP_HOST=mailpit
EMAIL_SMTP_CRYPTO=
EMAIL_SMTP_PORT=1025
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
EMAIL_VALIDATE=true
EMAIL_MAILTYPE=html
EMAIL_CHARSET=utf-8
EMAIL_BCC_BATCH_MODE=false
EMAIL_WORDWRAP=false
EMAIL_PRIORITY=3

API_ENABLED=false
API_JWT_KEY="jwt-local-de-teste-nao-usar-em-producao-0000000"
API_TOKEN_EXPIRE_TIME=3600
API_REFRESH_TOKEN_EXPIRE_TIME=2592000
API_CORS_ORIGINS=
API_RATE_LIMIT=300

UPDATER_PRERELEASES=false
IMPRIMIR_ANEXOS=false
STORAGE_PATH=/storage
UPLOAD_MAX_KB=
UPLOAD_MAX_PIXELS=
WHOOPS_ERROR_PAGE_ENABLED=false
